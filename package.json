{
  "name": "@krislintigo/eslint-config",
  "version": "2.6.0",
  "description": "Shared ESLint flat config for TypeScript projects.",
  "type": "module",
  "license": "MIT",
  "author": "krislintigo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krislintigo/eslint-config.git"
  },
  "homepage": "https://github.com/krislintigo/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/krislintigo/eslint-config/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "scripts": {
    "prepare": "release-kit install-hooks",
    "commitlint": "release-kit commitlint",
    "check": "release-kit check",
    "release": "release-kit release",
    "release:dry-run": "release-kit release --dry-run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "typescript"
  ],
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": ">=6.0.0 <7.0.0"
  },
  "devDependencies": {
    "@krislintigo/release-kit": "^1.3.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.9.0",
    "typescript-eslint": "^8.66.0"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
